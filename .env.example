# Supabase. Both values come from Project Settings → API.
#
# Only the PUBLISHABLE key belongs here — it ships inside the client bundle by
# design and is protected by row-level security. Never put the service_role key
# in this file or any other client-side config.
#
# Leave both unset to run the app in local-only mode (no sign-in, data on device).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
